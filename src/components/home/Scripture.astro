---
interface Props {
  title: string;
  text: string;
  refLabel: string;
}
const { title, text, refLabel } = Astro.props;
---

<section class="section-pad bg-(--color-bg-soft) px-4 text-center">
  <img
    src="/weaving.svg"
    alt=""
    width="36"
    height="40"
    class="reveal mx-auto mb-10 h-10 w-9 md:h-14 md:w-12.5"
    decoding="async"
    aria-hidden="true"
  />
  <p class="reveal font-script text-3xl text-(--color-cappuccino) md:text-4xl">{text}</p>
  <p class="reveal-late mt-8 text-sm uppercase tracking-widest text-(--color-muted)">{refLabel}</p>
  <h2 class="sr-only">{title}</h2>
</section>
