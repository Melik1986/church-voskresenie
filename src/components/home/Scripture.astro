---
interface Props {
  title: string;
  text: string;
  refLabel: string;
}
const { title, text, refLabel } = Astro.props;
---

<section class="bg-black px-4 py-28 text-center">
  <p class="font-script text-3xl text-[var(--color-accent)] md:text-4xl">{text}</p>
  <p class="mt-8 text-sm uppercase tracking-widest text-[var(--color-muted)]">{refLabel}</p>
  <h2 class="sr-only">{title}</h2>
</section>
