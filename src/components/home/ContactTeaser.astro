---
import TwoClickMap from '../embeds/TwoClickMap';
import { formatAddressLine, MAPS_EXTERNAL_URL } from '../../data/site';

interface Props {
  teaser: string;
  moreLabel: string;
  href: string;
  scheduleLabel: string;
  mapsOpen: string;
  mapsNotice: string;
}
const { teaser, moreLabel, href, scheduleLabel, mapsOpen, mapsNotice } = Astro.props;
---

<section id="contact" class="section-pad mx-auto max-w-3xl px-4">
  <div class="flex flex-col items-center gap-8 md:flex-row md:items-start md:justify-between md:gap-10">
    <div class="w-full min-w-0 text-center md:flex-1 md:text-left">
      <h2 class="reveal font-heading text-4xl">{teaser}</h2>
      <p class="reveal-late mt-4 text-(--color-muted)">{scheduleLabel}</p>
    </div>
    <img
      src="/fisch.svg"
      alt=""
      width="158"
      height="109"
      class="reveal-right h-auto w-32 shrink-0 object-contain sm:w-36 md:w-40 lg:w-44"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
  </div>
  <div class="reveal-slow mt-8">
    <TwoClickMap
      client:visible
      addressLine={formatAddressLine()}
      openLabel={mapsOpen}
      notice={mapsNotice}
      mapsUrl={MAPS_EXTERNAL_URL}
    />
  </div>
  <a class="btn-ghost reveal-late mt-8" href={href}>
    {moreLabel}
  </a>
</section>
