---
interface Props {
  teaser: string;
  moreLabel: string;
  href: string;
}
const { teaser, moreLabel, href } = Astro.props;
---

<section id="about" class="mx-auto max-w-3xl px-4 py-24">
  <p class="font-heading text-3xl leading-snug md:text-4xl">{teaser}</p>
  <a class="mt-8 inline-block text-sm uppercase tracking-widest text-[var(--color-accent)]" href={href}>
    {moreLabel}
  </a>
</section>
