---
interface Props {
  teaser: string;
  moreLabel: string;
  href: string;
}
const { teaser, moreLabel, href } = Astro.props;
---

<section id="about" class="mx-auto max-w-3xl px-4 py-24">
  <p class="reveal font-heading text-3xl leading-snug md:text-4xl">{teaser}</p>
  <a
    class="reveal-late mt-8 inline-block text-sm uppercase tracking-widest text-[var(--color-accent)] transition-opacity hover:opacity-70"
    href={href}
  >
    {moreLabel}
  </a>
</section>
