---
interface Props {
  teaser: string;
  moreLabel: string;
  href: string;
}
const { teaser, moreLabel, href } = Astro.props;
---

<section id="services" class="mx-auto max-w-3xl px-4 py-24">
  <h2 class="font-heading text-4xl">{teaser}</h2>
  <a class="mt-8 inline-block text-sm uppercase tracking-widest text-[var(--color-accent)]" href={href}>
    {moreLabel}
  </a>
</section>
