---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { resolveLocale, useTranslations } from '../../i18n/utils';
import { formatAddressLine, SOCIAL } from '../../data/site';
import SocialIcon from '../icons/SocialIcon.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const contentLinks = [
  { href: getRelativeLocaleUrl(locale, 'faith'), label: t('nav.faith') },
  { href: getRelativeLocaleUrl(locale, 'mission'), label: t('nav.mission') },
  { href: getRelativeLocaleUrl(locale, 'statute'), label: t('nav.statute') },
  { href: getRelativeLocaleUrl(locale, 'prayer'), label: t('nav.prayer') },
  { href: getRelativeLocaleUrl(locale, 'learn'), label: t('nav.learn') },
];
const legalLinks = [
  { href: getRelativeLocaleUrl(locale, 'impressum'), label: t('nav.impressum') },
  { href: getRelativeLocaleUrl(locale, 'datenschutz'), label: t('nav.datenschutz') },
];
---

<footer
  data-footer-fade
  class="footer-fade mt-24 border-t border-[var(--color-line)] bg-[var(--color-bg-soft)]"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-10 text-sm text-[var(--color-muted)]">
    <div class="flex flex-col gap-6 md:flex-row md:justify-between">
      <div>
        <p class="font-display text-[var(--color-fg)]">{t('footer.rights')}</p>
        <p class="mt-2">{formatAddressLine()}</p>
      </div>
      <div class="flex gap-4" aria-label="Social">
        <SocialIcon brand="youtube" href={SOCIAL.youtube} label="YouTube" />
        <SocialIcon brand="instagram" href={SOCIAL.instagram} label="Instagram" />
        <SocialIcon brand="facebook" href={SOCIAL.facebook} label="Facebook" />
      </div>
    </div>
    <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Content">
      {contentLinks.map((item) => (
        <a class="hover:text-[var(--color-fg)]" href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="flex gap-4">
      {legalLinks.map((item) => (
        <a class="hover:text-[var(--color-fg)]" href={item.href}>{item.label}</a>
      ))}
    </div>
  </div>
</footer>

<script>
  const footer = document.querySelector('[data-footer-fade]');
  if (footer) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      footer.classList.add('is-inview');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-inview');
            io.disconnect();
          }
        },
        { threshold: 0.45, rootMargin: '0px 0px -8% 0px' },
      );
      io.observe(footer);
    }
  }
</script>
