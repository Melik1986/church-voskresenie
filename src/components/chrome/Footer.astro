---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { resolveLocale, useTranslations } from '../../i18n/utils';
import { formatAddressLine, SOCIAL } from '../../data/site';
import SocialIcon from '../icons/SocialIcon.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const impressum = getRelativeLocaleUrl(locale, 'impressum');
const datenschutz = getRelativeLocaleUrl(locale, 'datenschutz');
---

<footer class="mt-24 border-t border-white/10 bg-black/40">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 text-sm text-[var(--color-muted)] md:flex-row md:justify-between">
    <div>
      <p class="font-display text-[var(--color-fg)]">{t('footer.rights')}</p>
      <p class="mt-2">{formatAddressLine()}</p>
    </div>
    <div class="flex gap-4" aria-label="Social">
      <SocialIcon brand="youtube" href={SOCIAL.youtube} label="YouTube" />
      <SocialIcon brand="instagram" href={SOCIAL.instagram} label="Instagram" />
      <SocialIcon brand="facebook" href={SOCIAL.facebook} label="Facebook" />
    </div>
    <div class="flex gap-4">
      <a class="hover:text-[var(--color-fg)]" href={impressum}>{t('nav.impressum')}</a>
      <a class="hover:text-[var(--color-fg)]" href={datenschutz}>{t('nav.datenschutz')}</a>
    </div>
  </div>
</footer>
