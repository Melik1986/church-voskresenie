---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { resolveLocale, useTranslations } from '../../i18n/utils';
import DesktopNav from './DesktopNav';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale, '/');
const primary = [
  { href: getRelativeLocaleUrl(locale, 'about'), label: t('nav.about') },
  { href: getRelativeLocaleUrl(locale, 'services'), label: t('nav.services') },
  { href: getRelativeLocaleUrl(locale, 'media'), label: t('nav.media') },
  { href: getRelativeLocaleUrl(locale, 'contact'), label: t('nav.contact') },
];
const learnLinks = [
  { href: getRelativeLocaleUrl(locale, 'faith'), label: t('nav.faith') },
  { href: getRelativeLocaleUrl(locale, 'mission'), label: t('nav.mission') },
  { href: getRelativeLocaleUrl(locale, 'statute'), label: t('nav.statute') },
  { href: getRelativeLocaleUrl(locale, 'prayer'), label: t('nav.prayer') },
];
const mobileLinks = [...primary.slice(0, 2), ...learnLinks, ...primary.slice(2)];
const other = locale === 'ru' ? 'de' : 'ru';
const switchHref =
  locale === 'ru'
    ? `/de${Astro.url.pathname === '/' ? '/' : Astro.url.pathname}`
    : Astro.url.pathname.replace(/^\/de/, '') || '/';
---

<header class="sticky top-0 z-40 overflow-visible border-b border-white/10 bg-[var(--color-bg)]/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={home} class="font-display text-lg tracking-wide text-[var(--color-fg)]">
      {t('brand.name')}
    </a>
    <div class="hidden lg:block">
      <DesktopNav
        client:load
        primary={primary}
        learnLabel={t('nav.learn')}
        learnLinks={learnLinks}
      />
    </div>
    <div class="flex items-center gap-3">
      <details class="relative lg:hidden">
        <summary
          class="cursor-pointer list-none rounded border border-white/20 px-2 py-1 text-xs uppercase tracking-widest text-[var(--color-muted)] hover:text-[var(--color-fg)]"
        >
          {t('nav.menu')}
        </summary>
        <nav
          class="absolute right-0 mt-2 flex w-64 flex-col gap-2 border border-white/10 bg-[var(--color-bg)] p-4 text-sm text-[var(--color-muted)] shadow-lg"
          aria-label="Mobile"
        >
          {mobileLinks.map((item) => (
            <a class="hover:text-[var(--color-fg)]" href={item.href}>{item.label}</a>
          ))}
        </nav>
      </details>
      <a
        class="rounded border border-white/20 px-2 py-1 text-xs uppercase tracking-widest text-[var(--color-muted)] hover:text-[var(--color-fg)]"
        href={switchHref}
        hreflang={other}
      >
        {other}
      </a>
    </div>
  </div>
</header>
