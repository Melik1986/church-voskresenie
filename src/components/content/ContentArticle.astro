---
import type { PageMedia } from '../../data/page-photos';
import PagePhotos from './PagePhotos.astro';

/**
 * Shared content article shell. Pass `heading` for the page H1, or omit when
 * the title is rendered outside (e.g. over a decorative mark).
 */
interface Props {
  heading?: string;
  media?: PageMedia;
  /** Drop default pt-16 (about title sits above the article). */
  flushTop?: boolean;
}
const { heading, media, flushTop = false } = Astro.props;
---

<article
  class:list={[
    'mx-auto max-w-3xl px-4 pb-0 leading-relaxed [&_h2]:font-heading [&_h2]:text-4xl [&_h2]:mt-10 [&_h3]:font-display [&_h3]:mt-8 [&_ol]:mt-6 [&_ol]:space-y-4 [&_p]:mt-4 [&_ul]:mt-4 [&_a]:text-(--color-accent) [&_li]:mt-2 [&_img[data-ornament]]:mx-auto [&_img[data-ornament]]:my-10 [&_img[data-ornament]]:block [&_img[data-ornament]]:h-auto [&_img[data-ornament]]:w-20 sm:[&_img[data-ornament]]:w-24',
    flushTop ? 'pt-0' : 'pt-16',
  ]}
>
  {heading ? <h1 class="font-heading text-5xl text-(--color-fg)">{heading}</h1> : null}
  {media?.hero ? <PagePhotos media={{ hero: media.hero }} /> : null}
  <div class="mt-8 mb-12">
    <slot />
  </div>
  {media?.sections?.length ? <PagePhotos media={{ sections: media.sections }} /> : null}
  <slot name="after-media" />
</article>
