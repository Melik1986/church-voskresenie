---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { resolveLocale, useTranslations } from '../../i18n/utils';

/**
 * Shared content article shell: one visible H1 from collection title.
 */
interface Props {
  heading: string;
}
const { heading } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const related = [
  { href: getRelativeLocaleUrl(locale, 'learn'), label: t('nav.learn') },
  { href: getRelativeLocaleUrl(locale, 'faith'), label: t('nav.faith') },
  { href: getRelativeLocaleUrl(locale, 'mission'), label: t('nav.mission') },
  { href: getRelativeLocaleUrl(locale, 'statute'), label: t('nav.statute') },
  { href: getRelativeLocaleUrl(locale, 'prayer'), label: t('nav.prayer') },
  { href: getRelativeLocaleUrl(locale, 'contact'), label: t('nav.contact') },
];
---

<article class="mx-auto max-w-3xl px-4 py-16 leading-relaxed [&_h2]:font-heading [&_h2]:text-4xl [&_h2]:mt-10 [&_h3]:font-display [&_h3]:mt-8 [&_ol]:mt-6 [&_ol]:space-y-4 [&_p]:mt-4 [&_ul]:mt-4 [&_a]:text-[var(--color-accent)] [&_li]:mt-2">
  <h1 class="font-heading text-5xl text-[var(--color-fg)]">{heading}</h1>
  <div class="mt-8">
    <slot />
  </div>
  <nav class="mt-12 flex flex-wrap gap-x-4 gap-y-2 text-sm uppercase tracking-widest not-prose" aria-label="Related">
    {related.map((item) => (
      <a class="text-[var(--color-accent)]" href={item.href}>{item.label}</a>
    ))}
  </nav>
</article>
