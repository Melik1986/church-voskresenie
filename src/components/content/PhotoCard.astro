---
import type { Photo } from '../../data/page-photos';

interface Props {
  photo: Photo;
}

const { photo } = Astro.props;
const showCaption = Boolean(photo.caption || photo.role);
---

<li class="overflow-hidden">
  <figure>
    <img
      src={photo.src}
      alt={photo.alt}
      width="800"
      height="600"
      class:list={['h-auto w-full object-cover', photo.rounded && 'rounded-xl']}
      loading="lazy"
      decoding="async"
    />
    {
      showCaption && (
        <figcaption class="mt-3 text-center md:text-left">
          {photo.caption && (
            <p class="font-display text-lg text-[var(--color-fg)]">{photo.caption}</p>
          )}
          {photo.role && (
            <p class="mt-1 text-sm uppercase tracking-widest text-[var(--color-muted)]">
              {photo.role}
            </p>
          )}
        </figcaption>
      )
    }
  </figure>
</li>
