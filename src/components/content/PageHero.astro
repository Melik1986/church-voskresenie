---
import type { Photo } from '../../data/page-photos';

/**
 * Full-bleed page hero under fixed header.
 * Section owns height (≤ viewport). Image never drives layout.
 *
 * fit (Tailwind object-fit):
 * - cover — landscape fills band (default)
 * - contain — full frame, letterbox on soft bg
 * - mobile — cover on phone/tablet, contain on lg+ (assets shot for narrow viewports)
 * - wide — cover until 1440px, then contain (address / contact)
 */
interface Props {
  photo: Photo;
  fit?: 'cover' | 'contain' | 'mobile' | 'wide';
}

const { photo, fit = 'cover' } = Astro.props;

const band =
  'h-[min(50svh,24rem)] sm:h-[min(55svh,28rem)] md:h-[min(60svh,34rem)] lg:h-[min(65svh,40rem)]';

const fitClass =
  fit === 'contain'
    ? 'object-contain'
    : fit === 'mobile'
      ? 'object-cover object-center lg:object-contain'
      : fit === 'wide'
        ? 'object-cover object-center min-[1024px]:object-contain'
        : 'object-cover object-center';

const imgClass = ['h-full w-full cursor-pointer', fitClass];
---

<section class:list={['page-hero w-full overflow-hidden bg-(--color-bg-soft)', band]}>
  {photo.videoSrc ? (
    <video src={photo.videoSrc} autoplay loop playsinline class:list={imgClass} id="hero-video" />
  ) : photo.srcLg ? (
    <picture class="contents">
      <source media="(min-width: 1024px)" srcset={photo.srcLg} />
      <img
        src={photo.src}
        alt={photo.alt}
        width="1200"
        height="800"
        class:list={imgClass}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  ) : (
    <img
      src={photo.src}
      alt={photo.alt}
      width="1200"
      height="800"
      class:list={imgClass}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}
</section>

{photo.videoSrc && <script>
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('hero-video') as HTMLVideoElement;
    if (video) {
      video.addEventListener('click', () => {
        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
      });
    }
  });
</script>}
