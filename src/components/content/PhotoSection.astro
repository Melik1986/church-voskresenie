---
import type { PhotoSection } from '../../data/page-photos';

interface Props {
  section: PhotoSection;
}

const { section } = Astro.props;
const multi = section.photos.length > 1;
---

<section class="page-photos__section mt-10">
  {
    section.label && (
      <h2 class="font-heading text-3xl text-[var(--color-fg)] md:text-4xl">{section.label}</h2>
    )
  }
  <ul class:list={['mt-6 grid gap-4', multi ? 'sm:grid-cols-2' : '']}>
    {
      section.photos.map((photo) => (
        <li class="overflow-hidden">
          <img
            src={photo.src}
            alt={photo.alt}
            width="800"
            height="600"
            class="h-auto w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))
    }
  </ul>
</section>
