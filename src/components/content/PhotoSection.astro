---
import type { PhotoSection as PhotoSectionData } from '../../data/page-photos';
import PhotoCard from './PhotoCard.astro';

interface Props {
  section: PhotoSectionData;
}

const { section } = Astro.props;
const multi = section.photos.length > 1;
---

<section class="page-photos__section mt-10">
  {
    section.label && (
      <h2 class="font-heading text-3xl text-[var(--color-fg)] md:text-4xl">{section.label}</h2>
    )
  }
  <ul class:list={['mt-6 grid gap-6', multi ? 'sm:grid-cols-2' : '']}>
    {section.photos.map((photo) => <PhotoCard photo={photo} />)}
  </ul>
</section>
