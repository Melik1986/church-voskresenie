---
import type { PageMedia } from '../../data/page-photos';

interface Props {
  media: PageMedia;
}

const { media } = Astro.props;
const { hero, sections = [] } = media;
---

{
  hero && (
    <figure class="page-photos__hero mt-8 overflow-hidden">
      <img
        src={hero.src}
        alt={hero.alt}
        width="1200"
        height="800"
        class="h-auto w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </figure>
  )
}

{
  sections.map((section) => (
    <section class="page-photos__section mt-10">
      {section.label && (
        <h2 class="font-heading text-3xl text-[var(--color-fg)] md:text-4xl">{section.label}</h2>
      )}
      <ul class:list={['mt-6 grid gap-4', section.photos.length > 1 ? 'sm:grid-cols-2' : '']}>
        {section.photos.map((photo) => (
          <li class="overflow-hidden">
            <img
              src={photo.src}
              alt={photo.alt}
              width="800"
              height="600"
              class="h-auto w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </section>
  ))
}
