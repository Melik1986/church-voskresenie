---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TwoClickMap from '../components/embeds/TwoClickMap';
import AnswerFacts from '../components/seo/AnswerFacts.astro';
import { resolveLocale, useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  formatAddressLine,
  MAPS_EXTERNAL_URL,
  SERVICE_TIME,
  SOCIAL,
  VENUE,
} from '../data/site';
import { buildAnswerFacts } from '../data/jsonld';
import SocialIcon from '../components/icons/SocialIcon.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const schedule = locale === 'de' ? SERVICE_TIME.labelDe : SERVICE_TIME.labelRu;
const entry = await getEntry('pages', `${locale}/contact`);
if (!entry) throw new Error(`Missing contact for ${locale}`);
const { Content } = await render(entry);
const facts = buildAnswerFacts(locale);
---

<Layout title={t('seo.contactTitle')} description={entry.data.description}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-heading text-5xl text-[var(--color-fg)]">{entry.data.title}</h1>
    <article class="prose-invert mt-8 leading-relaxed [&_h2]:font-heading [&_h2]:text-4xl [&_h3]:font-display [&_h3]:mt-8 [&_p]:mt-4">
      <Content />
    </article>
    <p class="mt-4 text-lg text-[var(--color-muted)]">{schedule}</p>
    <p class="mt-2 text-sm text-[var(--color-muted)]">
      {locale === 'de' ? VENUE.noteDe : VENUE.noteRu}
    </p>
    <div class="mt-10">
      <TwoClickMap
        client:visible
        addressLine={formatAddressLine()}
        openLabel={t('maps.open')}
        notice={t('maps.notice')}
        mapsUrl={MAPS_EXTERNAL_URL}
      />
    </div>
    <div class="mt-10 flex gap-4">
      <SocialIcon brand="youtube" href={SOCIAL.youtube} label="YouTube" />
      <SocialIcon brand="instagram" href={SOCIAL.instagram} label="Instagram" />
      <SocialIcon brand="facebook" href={SOCIAL.facebook} label="Facebook" />
    </div>
    <nav class="mt-10 flex flex-wrap gap-4 text-sm uppercase tracking-widest text-[var(--color-accent)]" aria-label="Related">
      <a href={getRelativeLocaleUrl(locale, 'about')}>{t('nav.about')}</a>
      <a href={getRelativeLocaleUrl(locale, 'services')}>{t('nav.services')}</a>
      <a href={getRelativeLocaleUrl(locale, 'media')}>{t('nav.media')}</a>
    </nav>
  </section>
  <AnswerFacts title={t('facts.title')} items={facts} />
</Layout>
