---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { resolveLocale, useTranslations } from '../../i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const entry = await getEntry('pages', `${locale}/datenschutz`);
if (!entry) throw new Error(`Missing datenschutz for ${locale}`);
const { Content } = await render(entry);
---

<Layout title={t('seo.datenschutzTitle')} description={entry.data.description}>
  <article class="prose-invert mx-auto max-w-3xl px-4 py-16 leading-relaxed [&_h1]:font-heading [&_h1]:text-5xl [&_h2]:mt-8 [&_h2]:font-display">
    <Content />
  </article>
</Layout>
