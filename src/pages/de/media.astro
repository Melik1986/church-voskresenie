---
import Layout from '../../layouts/Layout.astro';
import MediaVideoHero from '../../components/content/MediaVideoHero.tsx';
import MediaDepthGallery from '../../components/content/MediaDepthGallery.tsx';
import { resolveLocale, useTranslations } from '../../i18n/utils';
import { SOCIAL, orgName } from '../../data/site';
import { pageMedia } from '../../data/page-photos';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const gallery = pageMedia('media', locale).gallery ?? [];
---

<Layout title={t('seo.mediaTitle')} description={t('seo.mediaDesc')}>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-4" aria-label={t('nav.media')}>
    <MediaVideoHero
      client:load
      photos={gallery}
      brand={orgName(locale)}
      channelUrl={SOCIAL.youtube}
      notice={t('yt.notice')}
      loadLabel={t('yt.load')}
      channelLabel="YouTube"
      handle="@auferstehungsgemeinde_ua"
    />
  </section>
  <section class="mx-auto max-w-3xl px-4 pb-0 pt-8">
    <h1 class="font-heading text-5xl">{t('media.title')}</h1>
    <p class="mt-4 text-[var(--color-muted)]">{t('media.lead')}</p>
    <div class="mt-8 mb-8 space-y-4 text-[var(--color-muted)]">
      <p>{t('media.how')}</p>
      <p>{t('media.where')}</p>
    </div>
  </section>
  {
    gallery.length > 0 && (
      <MediaDepthGallery client:visible photos={gallery} label={t('nav.media')} />
    )
  }
</Layout>
