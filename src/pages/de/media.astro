---
import Layout from '../../layouts/Layout.astro';
import TwoClickYouTube from '../../components/embeds/TwoClickYouTube';
import { resolveLocale, useTranslations } from '../../i18n/utils';
import { SOCIAL } from '../../data/site';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Layout title={t('seo.mediaTitle')} description={t('media.lead')}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-heading text-5xl">{t('media.title')}</h1>
    <p class="mt-4 text-[var(--color-muted)]">{t('media.lead')}</p>
    <div class="mt-10">
      <TwoClickYouTube
        client:visible
        notice={t('yt.notice')}
        loadLabel={t('yt.load')}
        channelUrl={SOCIAL.youtube}
        channelLabel="YouTube"
      />
    </div>
  </section>
</Layout>
