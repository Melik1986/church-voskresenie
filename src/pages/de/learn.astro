---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { resolveLocale, useTranslations } from '../../i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const entry = await getEntry('pages', `${locale}/learn`);
if (!entry) throw new Error(`Missing learn for ${locale}`);
const { Content } = await render(entry);
---

<Layout title={t('seo.learnTitle')} description={entry.data.description}>
  <article class="prose-invert mx-auto max-w-3xl px-4 py-16 leading-relaxed [&_h2]:font-heading [&_h2]:text-4xl [&_h2]:mt-10 [&_a]:text-[var(--color-accent)] [&_ul]:mt-6 [&_li]:mt-2">
    <Content />
  </article>
</Layout>
