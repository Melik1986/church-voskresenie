---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { resolveLocale, useTranslations } from '../../i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const entry = await getEntry('pages', `${locale}/services`);
if (!entry) throw new Error(`Missing services content for ${locale}`);
const { Content } = await render(entry);
---

<Layout title={t('seo.servicesTitle')} description={entry.data.description}>
  <article class="prose-invert mx-auto max-w-3xl px-4 py-16 leading-relaxed [&_h2]:font-heading [&_h2]:text-4xl [&_h2]:mt-10 [&_h3]:font-display [&_h3]:mt-8">
    <Content />
  </article>
</Layout>
