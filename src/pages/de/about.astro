---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContentArticle from '../../components/content/ContentArticle.astro';
import PageHero from '../../components/content/PageHero.astro';
import AboutLifeCoverflow from '../../components/content/AboutLifeCoverflow.tsx';
import { resolveLocale, useTranslations } from '../../i18n/utils';
import { pageMedia } from '../../data/page-photos';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const entry = await getEntry('pages', `${locale}/about`);
if (!entry) throw new Error(`Missing about content for ${locale}`);
const { Content } = await render(entry);
const media = pageMedia('about', locale);
const gallery = media.gallery ?? [];
---

<Layout title={t('seo.aboutTitle')} description={entry.data.description}>
  {media.hero ? <PageHero photo={media.hero} /> : null}
  <div class="relative mx-auto mt-10 flex w-fit items-center justify-center">
    <img
      src="/vine-group.svg"
      alt=""
      width="300"
      height="331"
      class="h-auto w-36 sm:w-40 md:w-44 lg:w-48"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
    <h1
      class="pointer-events-none absolute inset-0 flex items-center justify-center px-2 text-center font-heading text-4xl text-[var(--color-fg)] sm:text-5xl"
    >
      {entry.data.title}
    </h1>
  </div>
  <ContentArticle flushTop media={{ sections: media.sections }}>
    <Content />
    {
      gallery.length > 0 && (
        <AboutLifeCoverflow
          slot="after-media"
          client:visible
          photos={gallery}
          locale={locale}
        />
      )
    }
  </ContentArticle>
</Layout>
