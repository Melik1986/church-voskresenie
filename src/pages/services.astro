---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ContentArticle from '../components/content/ContentArticle.astro';
import { resolveLocale, useTranslations } from '../i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const entry = await getEntry('pages', `${locale}/services`);
if (!entry) throw new Error(`Missing services for ${locale}`);
const { Content } = await render(entry);
---

<Layout title={t('seo.servicesTitle')} description={entry.data.description}>
  <ContentArticle heading={entry.data.title}>
    <Content />
  </ContentArticle>
</Layout>
