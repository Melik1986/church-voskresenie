---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import { resolveLocale } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import SeoHead from '../components/seo/SeoHead.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const lang = resolveLocale(Astro.currentLocale);
const path = Astro.url.pathname;
const isHome = path === '/' || path === '/de' || path === '/de/';
const heroPoster = '/animation/0001.webp';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    {
      isHome && (
        <link
          rel="preload"
          href={heroPoster}
          as="image"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }
    <SeoHead
      title={title}
      description={description}
      locale={lang as Locale}
      path={path}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body class:list={[{ 'is-home': isHome }]}>
    <Header />
    <script is:inline>
      (() => {
        const header = document.querySelector('[data-site-header]');
        if (!header) return;
        const sync = () => {
          document.documentElement.style.setProperty(
            '--site-header-h',
            `${header.offsetHeight}px`,
          );
        };
        sync();
        window.addEventListener('resize', sync, { passive: true });
      })();
    </script>
    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      // Mobile URL-bar resize was refreshing pins → layout jump
      ScrollTrigger.config({ ignoreMobileResize: true });

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        bootScroll();
      }

      /** Lenis + reveal. GSAP scrub everywhere; CSS view() = no-JS fallback in global.css. */
      function bootScroll(): void {
        const lenis = new Lenis({ autoRaf: false });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);
        initReveal();
      }

      function initReveal(): void {
        document.documentElement.classList.add('reveal-gsap');
        bindGsapReveals();
      }

      function bindGsapReveals(): void {
        // Early entry: finish while element is still in lower half of viewport
        const ranges: Record<string, { start: string; end: string }> = {
          reveal: { start: 'top bottom', end: 'top 72%' },
          'reveal-slow': { start: 'top bottom+=48', end: 'top 80%' },
          'reveal-late': { start: 'top bottom', end: 'top 68%' },
          'reveal-right': { start: 'top bottom', end: 'top 72%' },
        };
        for (const [cls, range] of Object.entries(ranges)) {
          document.querySelectorAll(`.${cls}`).forEach((node) => {
            const fromRight = cls === 'reveal-right';
            scrubReveal(node as HTMLElement, range.start, range.end, fromRight);
          });
        }
      }

      function scrubReveal(
        el: HTMLElement,
        start: string,
        end: string,
        fromRight = false,
      ): void {
        gsap.fromTo(el, revealFrom(fromRight), {
          ...revealTo(fromRight),
          ease: 'none',
          scrollTrigger: { trigger: el, start, end, scrub: true },
        });
      }

      function revealFrom(fromRight: boolean) {
        return {
          opacity: 0,
          scale: 0.9,
          filter: 'blur(12px)',
          ...(fromRight ? { x: 80 } : { y: 80 }),
        };
      }

      function revealTo(fromRight: boolean) {
        return {
          opacity: 1,
          scale: 1,
          filter: 'blur(0px)',
          ...(fromRight ? { x: 0 } : { y: 0 }),
        };
      }
    </script>
  </body>
</html>
