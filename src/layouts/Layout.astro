---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import { resolveLocale } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import SeoHead from '../components/seo/SeoHead.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const lang = resolveLocale(Astro.currentLocale);
const path = Astro.url.pathname;
const isHome = path === '/' || path === '/de' || path === '/de/';
const heroPoster = '/animation/0001.webp';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    {
      isHome && (
        <link
          rel="preload"
          href={heroPoster}
          as="image"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }
    <SeoHead
      title={title}
      description={description}
      locale={lang as Locale}
      path={path}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body class:list={[{ 'is-home': isHome }]}>
    <Header />
    <script is:inline>
      (() => {
        const header = document.querySelector('[data-site-header]');
        if (!header) return;
        const sync = () => {
          document.documentElement.style.setProperty(
            '--site-header-h',
            `${header.offsetHeight}px`,
          );
        };
        sync();
        window.addEventListener('resize', sync, { passive: true });
      })();
    </script>
    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      initReveal();

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ autoRaf: false });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);
      }

      /** CSS view() on desktop; IntersectionObserver on touch / no SDA. */
      function initReveal(): void {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (canUseCssViewTimeline()) return;
        document.documentElement.classList.add('reveal-io');
        observeReveals();
      }

      function canUseCssViewTimeline(): boolean {
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        return fine && CSS.supports('animation-timeline', 'view()');
      }

      function observeReveals(): void {
        const nodes = document.querySelectorAll('.reveal, .reveal-slow, .reveal-late');
        if (nodes.length === 0) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-inview');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        nodes.forEach((node) => io.observe(node));
      }
    </script>
  </body>
</html>
